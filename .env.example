# 이 파일을 .env.local 로 복사해 실제 값을 넣는다. .env.local 은 git에 올라가지 않는다.
# 로컬 Supabase 값은 `supabase status` 로 확인한다.

# 앱 주소 (로그인 메일의 돌아올 주소에 쓰인다)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Supabase 공개 접속 정보 (브라우저에도 노출되는 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 로그인을 허용할 이메일(쉼표로 구분). 본인 1명. 비우면 아무도 로그인할 수 없다.
ALLOWED_USER_EMAILS=

# 관리자 키: scripts/create-owner.mts 에서만 사용. 앱 코드에서 쓰지 않는다. 운영 서버에는 넣지 않는다.
SUPABASE_SECRET_KEY=
