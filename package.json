{
  "name": "marketing-office",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "e2e": "playwright test",
    "e2e:reset": "supabase db reset && node --env-file=.env.local scripts/create-owner.mts owner@marketing-office.test --password Owner-test-1234",
    "seed:review": "node --env-file=.env.local scripts/seed-review-data.mts",
    "db:types": "supabase gen types typescript --schema public > src/server/supabase/database.types.ts",
    "backup": "node --env-file=.env.local scripts/backup/backup.mts",
    "backup:verify": "node --env-file=.env.local scripts/backup/verify-cli.mts",
    "backup:restore-drill": "node --env-file=.env.local scripts/backup/restore-drill.mts",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@napi-rs/canvas": "1.1.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "unpdf": "2.1.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
